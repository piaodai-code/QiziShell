{
  "name": "qizi-shell",
  "version": "0.2.3-6",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "restart": "bash scripts/restart-dev.sh",
    "build": "electron-builder --mac --publish never",
    "ship": "bash scripts/ship.sh",
    "release": "bash scripts/release-mac.sh",
    "test:meeting-relay": "node scripts/meeting-relay-smoke.js",
    "test:private-channel": "node scripts/private-channel-smoke.js",
    "test:hermes-client": "node scripts/hermes-client-smoke.js",
    "test:gateway-disconnect": "node scripts/gateway-disconnect-smoke.js",
    "test:markdown-live": "node scripts/markdown-live-smoke.mjs",
    "build:editor": "esbuild scripts/codemirror-entry.js --bundle --format=iife --global-name=QiziMarkdownEditor --outfile=vendor/codemirror-markdown.js"
  },
  "build": {
    "appId": "com.qizi.shell",
    "productName": "QiziShell",
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "启孜 Shell 需要访问麦克风，用于语音转文字与设置中的识别测试。"
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "gateway-ws.js",
      "tls-policy.js",
      "export-html.js",
      "export-docx.js",
      "composer-markdown-input.js",
      "stt-manager.js",
      "device-identity.js",
      "device-auth-store.js",
      "device-auth-payload.js",
      "index.html",
      "history.html",
      "hermes-client.js",
      "maintaining-session.js",
      "maintaining.html",
      "maintaining.js",
      "maintaining.css",
      "maintaining-preload.js",
      "copy-edit.html",
      "copy-edit.css",
      "copy-edit.js",
      "copy-edit-model.js",
      "copy-edit-preload.js",
      "about.html",
      "about.js",
      "about.css",
      "meeting-help.html",
      "meeting-help.js",
      "meeting-help.css",
      "meeting-help-preload.js",
      "update.html",
      "update.js",
      "update.css",
      "update-preload.js",
      "update-checker.js",
      "forward-format.js",
      "private-channel.js",
      "message-archive.js",
      "meeting-forward.js",
      "meeting-*.js",
      "style.css",
      "app.js",
      "history.js",
      "history-preload.js",
      "message-view.js",
      "message-time.js",
      "tool-stream.js",
      "chat-timeline.js",
      "code-block.js",
      "agent-files.js",
      "agent-files.html",
      "agent-files.css",
      "agent-files-view.js",
      "agent-files-preload.js",
      "vendor/codemirror-markdown.js",
      "marked.min.js",
      "dompurify.min.js",
      "assets/icons/**",
      "assets/sounds/**",
      "assets/about-icon.png",
      "assets/maintaining-avatar.png",
      "assets/update-hero.png",
      "tray-icon.png"
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "dompurify": "^3.4.9",
    "isomorphic-dompurify": "^3.16.0",
    "marked": "^18.0.5",
    "tmp-promise": "^3.0.3",
    "ws": "^8.21.0"
  }
}
